apiVersion: pipecd.dev/v1beta1
kind: Piped
spec:
  projectID: quickstart
  pipedID: __PIPED_ID__
  pipedKeyData: __PIPED_KEY_DATA__
  apiAddress: __CONTROL_PLANE_ADDR__
  syncInterval: 30s
  repositories:
    - repoId: workshop
      remote: __WORKSHOP_REPO_URL__
      branch: __BASE_BRANCH__
  plugins:
    - name: kubernetes_multicluster
      port: 7002
      url: file://__PLUGINS_DIR__/kubernetes_multicluster
      deployTargets:
        - name: cluster1
          config:
            kubeConfigPath: __KUBE_DIR__/cluster1
        - name: cluster2
          config:
            kubeConfigPath: __KUBE_DIR__/cluster2
    - name: wait
      port: 7004
      url: file://__PLUGINS_DIR__/wait
